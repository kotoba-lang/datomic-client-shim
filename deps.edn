{:paths ["src"]
 ;; kotobase (kotoba-lang/kotobase) provides the IStore/ITransactionalStore
 ;; seam (kotobase.store) this handler audits queries through directly
 ;; (kotobase.protocols.datomic requires kotobase.store itself for
 ;; st/-append/-read, same as every kotobase-protocols-family handler).
 ;;
 ;; ayatori (kotoba-lang/ayatori, formerly kotobase-query) provides
 ;; kotobase.query.bridge -- the actual materialize+query engine this
 ;; handler delegates to (ADR-2607172300's named prerequisite bridge; see
 ;; the docstring in src/kotobase/protocols/datomic.cljk). Pinned to its
 ;; HEAD as of this noble-drop landing. ayatori's own deps.edn pins
 ;; kotobase/arrangement/io-ipld/io-multiformats/io-ipni-specs; tools.deps
 ;; resolves that whole chain automatically for the JVM :test alias from the
 ;; direct deps here. The nbb primary test path has no dependency resolver,
 ;; so bin/run_tests.cljk / CI clone every transitive dep by hand and list
 ;; every src dir on --classpath -- see README's Develop/test section.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/kotobase
        {:git/sha "bbf57df9dde5c1869182012860129a598382e088"}
        io.github.kotoba-lang/ayatori
        {:git/url "https://github.com/kotoba-lang/ayatori.git"
         :git/sha "d50ff2529daf428a5e3b8e43d1ca8ec0d6239c29"}
        io.github.kotoba-lang/kotobase-engine
        {:git/url "https://github.com/kotoba-lang/kotobase-engine.git"
         :git/sha "b8b163e889341cdf49217570380872e0575fcbdd"}}
 ;; First-class runtime is nbb/cljs (repo-wide runtime priority):
 ;;   nbb --classpath "src:test:.deps/kotobase/src:.deps/ayatori/src:.deps/arrangement/src:.deps/prolly-tree/src:.deps/io-ipld/src:.deps/io-multiformats/src:.deps/org-nist-sha2/src:.deps/org-ietf-cbor/src:.deps/dev-protobuf/src:.deps/datom-source/src:.deps/datalog/src:.deps/io-ipni-specs/src" bin/run_tests.cljk
 ;; The :test alias below is the :clj COMPAT suite only -- not the
 ;; primary execution path.
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
        ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
        :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
               :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                           "--fail-level" "error"]}}}
